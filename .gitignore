# Learn more about .gitignore:
#     https://www.atlassian.com/git/tutorials/saving-changes/gitignore

# Node artifact files
node_modules/
dist/

# Compiled Java class files
*.class

# Compiled Python bytecode
*.py[cod]
__pycache__/

# Jupyter
.ipynb_checkpoints/

# Virtual environments
.venv/
venv/

# Log files
*.log

# Package files
*.jar

# Maven
target/
dist/

# JetBrains IDE
.idea/

# Unit test reports
TEST*.xml

# Generated by MacOS
.DS_Store

# Generated by Windows
Thumbs.db

# Applications
*.app
*.exe
*.war

# Large media files
*.mp4
*.tiff
*.avi
*.flv
*.mov
*.wmv

# Precomputed models
precomputed_model*

# 本地文件，不入库
# results.zip 是 results/ 的 Finder 压缩副本（含 __MACOSX 垃圾），内容与 results/ 重复
results.zip
